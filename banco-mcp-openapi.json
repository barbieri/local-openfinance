          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bill_ids": {
                    "type": "array",
                    "description": "Bill uuids. 1-50."
                  }
                },
                "required": ["bill_ids"]
              },
              "example": {
                "bill_ids": ["uuid-bill-1"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_get_credit_card_bill",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/investments/list": {
      "post": {
        "operationId": "openfinance_list_investments",
        "summary": "Investment portfolio per connection",
        "tags": ["investments"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "description": "Filter by type.",
                    "enum": [
                      "COE",
                      "EQUITY",
                      "ETF",
                      "FIXED_INCOME",
                      "MUTUAL_FUND",
                      "SECURITY",
                      "OTHER"
                    ]
                  },
                  "page": {
                    "type": "number"
                  },
                  "page_size": {
                    "type": "number",
                    "description": "1-500, default 100."
                  }
                }
              },
              "example": {
                "item": "612",
                "type": "FIXED_INCOME"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_list_investments",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/investments/transactions/list": {
      "post": {
        "operationId": "openfinance_list_investment_transactions",
        "summary": "Movement history of an investment position (BUY/SELL/TAX/…)",
        "tags": ["investments"],
