    "/api/openfinance/categories/list": {
      "post": {
        "operationId": "openfinance_list_categories",
        "summary": "Transaction category taxonomy (Pluggy)",
        "tags": ["categories"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
