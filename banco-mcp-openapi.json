{
  "openapi": "3.1.0",
  "info": {
    "title": "Banco MCP — MCP.AI REST API",
    "description": "Aggregates bank data (balances, bills and statements) via Brazil's Open Finance. Each institution becomes a connection; multiple banks per user are stored in credentials.connections[]. Read-only.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.mcp.ai"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Workspace API key (sk_live_…) or OAuth access token."
      }
    }
  },
  "paths": {
    "/api/openfinance/connectors/search": {
      "post": {
        "operationId": "openfinance_search_bank_connectors",
        "summary": "Search bank connectors (Open Finance/API) by name",
        "tags": ["connections"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "keywords": {
                    "type": "array",
                    "description": "Bank name/id terms (OR match), e.g. ['nubank','btg']. Required."
                  },
                  "include_accounts": {
                    "type": "boolean",
                    "description": "Include accounts (+ count) of each already-linked connection. One call per connection; default false."
                  }
                },
                "required": ["keywords"]
              },
              "example": {
                "keywords": ["btg", "nubank"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_search_bank_connectors",
                  "result": {
                    "banks": [
                      {
                        "id": "675",
                        "name": "BTGPactual",
                        "access": "open_finance",
                        "type": "PERSONAL_BANK",
                        "audience": "pf",
                        "connect_url": "https://app.mcp.ai/connect/mi_…?u=usr_…&flow=quick&field_bank_id=675"
                      }
                    ],
                    "connect_url_base": "https://app.mcp.ai/connect/mi_…?u=usr_…&flow=quick",
                    "totals": {
                      "matched": 1,
                      "connected_connections": 0,
                      "connected_accounts": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/connections/list": {
      "post": {
        "operationId": "openfinance_list_connections",
        "summary": "List connected banks",
        "tags": ["connections"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_list_connections",
                  "result": {
                    "connections": [
                      {
                        "connector_id": "612",
                        "connector_name": "Nubank",
                        "item_id": "uuid-aaa",
                        "status": "UPDATED"
                      }
                    ],
                    "count": 1,
                    "add_connection_url": "https://app.mcp.ai/connect/mi_…?u=usr_…&add=1"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/connections/status": {
      "post": {
        "operationId": "openfinance_get_item_status",
        "summary": "Status of a connection (UPDATED, LOGIN_ERROR…)",
        "tags": ["connections"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "item_id (uuid), connector_id ('612'), or connector_name ('Nubank'). Omit when only 1 connection."
                  }
                }
              },
              "example": {
                "item": "612"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_get_item_status",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/connections/sync": {
      "post": {
        "operationId": "openfinance_force_sync",
        "summary": "Force-sync one or more connections",
        "tags": ["connections"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "description": "Connection selectors (item_id, connector_id, or connector_name). 1-50."
                  }
                },
                "required": ["items"]
              },
              "example": {
                "items": ["612", "Itaú"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_force_sync",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/connections/disconnect": {
      "post": {
        "operationId": "openfinance_disconnect_bank",
        "summary": "Revoke Open Finance consent for a bank",
        "tags": ["connections"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "item_id (uuid), connector_id, or connector_name of the connection."
                  }
                },
                "required": ["item"]
              },
              "example": {
                "item": "Nubank"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_disconnect_bank",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/accounts/list": {
      "post": {
        "operationId": "openfinance_list_accounts",
        "summary": "List accounts (BANK / CREDIT) of a connection",
        "tags": ["accounts"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "Target connection."
                  },
                  "type": {
                    "type": "string",
                    "description": "Filter by type.",
                    "enum": ["BANK", "CREDIT"]
                  }
                }
              },
              "example": {
                "item": "612",
                "type": "BANK"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_list_accounts",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/accounts/detail": {
      "post": {
        "operationId": "openfinance_get_accounts_detail",
        "summary": "Full account detail by id (batch 1-50)",
        "tags": ["accounts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_ids": {
                    "type": "array",
                    "description": "Account uuids. 1-50."
                  }
                },
                "required": ["account_ids"]
              },
              "example": {
                "account_ids": ["uuid-a", "uuid-b"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_get_accounts_detail",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/accounts/balance": {
      "post": {
        "operationId": "openfinance_get_account_balance",
        "summary": "Real-time balance per account (batch 1-50)",
        "tags": ["accounts"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_ids": {
                    "type": "array",
                    "description": "Account uuids. 1-50."
                  }
                },
                "required": ["account_ids"]
              },
              "example": {
                "account_ids": ["uuid-a", "uuid-b"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_get_account_balance",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/transactions/list": {
      "post": {
        "operationId": "openfinance_list_transactions",
        "summary": "Transactions per account (BANK or CREDIT) with date/keyword filters",
        "tags": ["transactions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_id": {
                    "type": "string",
                    "description": "Account uuid."
                  },
                  "from": {
                    "type": "string",
                    "description": "Start date ISO (YYYY-MM-DD)."
                  },
                  "to": {
                    "type": "string",
                    "description": "End date ISO (YYYY-MM-DD)."
                  },
                  "page": {
                    "type": "number",
                    "description": "Page (default 1)."
                  },
                  "page_size": {
                    "type": "number",
                    "description": "Items per page (1-500, default 50)."
                  },
                  "search_queries": {
                    "type": "array",
                    "description": "Keyword filter (OR). Triggers aggregated scan in from/to."
                  },
                  "detail": {
                    "type": "string",
                    "description": "Response shape: omit for compact (default), \"rich\" for bill/merchant metadata, or \"raw\" for the full upstream Open Finance object.",
                    "enum": ["rich", "raw"]
                  }
                },
                "required": ["account_id"]
              },
              "example": {
                "account_id": "uuid-a",
                "from": "2026-04-01",
                "to": "2026-04-30",
                "search_queries": ["uber", "ifood"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_list_transactions",
                  "result": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/credit-card-bills/list": {
      "post": {
        "operationId": "openfinance_list_credit_card_bills",
        "summary": "Credit card bills (with derived payment_status)",
        "tags": ["credit_cards"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_id": {
                    "type": "string",
                    "description": "CREDIT account uuid."
                  },
                  "page": {
                    "type": "number"
                  },
                  "page_size": {
                    "type": "number",
                    "description": "1-100."
                  }
                },
                "required": ["account_id"]
              },
              "example": {
                "account_id": "uuid-credit"
              }
            }
          }
        },
        "responses": {
