      "post": {
        "operationId": "openfinance_list_loans",
        "summary": "Loan contracts per connection (batch)",
        "tags": ["loans"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "description": "Connection selectors. 1-50."
                  }
                },
                "required": ["items"]
              },
              "example": {
                "items": ["612"]
              }
