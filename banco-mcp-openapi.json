            }
          }
        }
      }
    },
    "/api/openfinance/transactions/category": {
      "post": {
        "operationId": "openfinance_update_transaction_category",
        "summary": "Fix transaction categories (auto-creates a rule)",
        "tags": ["transactions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "description": "{ transaction_id, category_id } pairs. 1-50. category_id comes from /categories/list."
                  }
                },
                "required": ["items"]
              },
              "example": {
                "items": [
                  {
                    "transaction_id": "uuid-tx-1",
                    "category_id": "05080000"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "openfinance_update_transaction_category",
                  "result": {
                    "updated": 1,
                    "results": [
                      {
                        "transaction_id": "uuid-tx-1",
                        "category": "Food and drink",
                        "categoryId": "05080000"
                      }
                    ],
                    "errors": []
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/openfinance/report": {
      "post": {
        "operationId": "report_bug",
        "summary": "Report a problem, empty or unexpected data, or a suspected platform bug to the MCP.AI team",
        "tags": ["report"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "What went wrong or what you expected to happen"
                  },
                  "context": {
                    "type": "string",
                    "description": "Endpoint that failed, error message, or what you were trying to do"
                  },
                  "conversation": {
                    "type": "array",
                    "description": "Recent messages for reproduction. Array of { role, content, tool_name? }"
                  }
                },
                "required": ["message"]
              },
              "example": {
                "message": "investments/list returned empty for one of my connections",
                "context": "POST /api/openfinance/investments/list with item=...",
                "conversation": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "tool": "report_bug",
                  "result": {
                    "report_id": "bug_...",
                    "message": "Report received (bug_...). The MCP.AI team has been notified. Thank you!"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
