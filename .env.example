OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Debug traces are useful while setting up prompts and configs because they show what the CLI is doing.
# Reduce this to LOG_LEVEL=warn for real usage because debug can include compiled model inputs.
LOG_LEVEL=debug
TZ=America/Sao_Paulo

OPENFINANCE_BASE_URL=https://api.mcp.ai/api/openfinance
OPENFINANCE_API_KEY=sk_live_XXX

# Local web UI (serve command) — personal localhost only; not production auth
LOCAL_OPENFINANCE_WEB_TOKEN=
LOCAL_OPENFINANCE_WEB_PORT=3847

# SMTP password. The topic JSON notify.smtp.auth.passEnvVar names this variable
# (examples use SMTP_PASS). The secret stays here, never in the JSON.
# Gmail: smtp.gmail.com port 587 and a 16-character App Password, not the
# account login password. https://myaccount.google.com/apppasswords
SMTP_PASS=

# Optional: announce the web UI as a Tailscale Service when `serve` starts.
# Define the Service first in https://login.tailscale.com/admin/services
# Host must use a tag-based Tailscale identity (not a user login).
# LOCAL_OPENFINANCE_TAILSCALE_SERVICE=local-openfinance
# LOCAL_OPENFINANCE_TAILSCALE_HTTPS_PORT=443
